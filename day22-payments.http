### ---------------------------------------------------------- setup: an ISSUED invoice of 31.00

### S1 complete appointment 1 (Haircut 25.00 + 24 %)  -> draft invoice
PATCH {{host}}/appointments/1/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {% client.test("S1 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### S2 find the draft
GET {{host}}/invoices?appointmentId=1
Authorization: Bearer {{owner}}

> {%
    client.test("S2 found", () => client.assert(response.body.totalElements === 1, "totalElements " + response.body.totalElements));
    client.global.set("inv", response.body.content[0].id);
%}

### S3 a DRAFT cannot receive payments  -> 409
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-draft
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {% client.test("S3 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### S4 issue it  -> total 31.00
POST {{host}}/invoices/{{inv}}/issue
Authorization: Bearer {{owner}}

> {%
    client.test("S4 issued", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.total === 31, "total " + response.body.total);
    });
%}

### S5 nothing paid yet
GET {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}

> {%
    client.test("S5 balance 31", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.paid === 0, "paid " + response.body.paid);
        client.assert(response.body.balance === 31, "balance " + response.body.balance);
        client.assert(response.body.payments.length === 0, "payments " + response.body.payments.length);
    });
%}


### ---------------------------------------------------------- bad requests (400)

### B1 no Idempotency-Key header  -> 400
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {% client.test("B1 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### B2 key too short  -> 400
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: abc
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {% client.test("B2 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### B3 amount 0  -> 400
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-b3
Content-Type: application/json

{ "amount": 0, "method": "CASH" }

> {% client.test("B3 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### B4 three decimals  -> 400
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-b4
Content-Type: application/json

{ "amount": 10.001, "method": "CASH" }

> {% client.test("B4 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### B5 unknown method  -> 400
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}

Content-Type: application/json

{ "amount": 10.00, "method": "BITCOIN" }

> {% client.test("B5 400", () => client.assert(response.status === 400, "status " + response.status)); %}


### ---------------------------------------------------------- the idempotency key at work

### K1 first payment 10.00 with key ...0001  -> 201, NEW, balance 21.00
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0001
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {%
    client.test("K1 201 new", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "false", "replayed header");
        client.assert(response.body.amount === 10, "amount " + response.body.amount);
        client.assert(response.body.balanceAfter === 21, "balanceAfter " + response.body.balanceAfter);
        client.assert(response.body.invoicePaid === false, "invoicePaid");
    });
    client.global.set("payment1", response.body.id);
%}

### K2 EXACTLY the same request again (a retry)  -> 201, REPLAYED, same payment id, still balance 21.00
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0001
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {%
    client.test("K2 replayed", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "true", "replayed header");
        client.assert(response.body.id == client.global.get("payment1"), "id " + response.body.id);
        client.assert(response.body.balanceAfter === 21, "balanceAfter " + response.body.balanceAfter);
    });
%}

### K3 same key, amount written as 10 instead of 10.00 (same value)  -> still a replay
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0001
Content-Type: application/json

{ "amount": 10, "method": "CASH" }

> {%
    client.test("K3 replayed", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "true", "replayed header");
        client.assert(response.body.id == client.global.get("payment1"), "id " + response.body.id);
    });
%}

### K4 same key, DIFFERENT amount  -> 422 (a client bug: neither replaying nor paying would be right)
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0001
Content-Type: application/json

{ "amount": 11.00, "method": "CASH" }

> {% client.test("K4 422", () => client.assert(response.status === 422, "status " + response.status)); %}

### K5 still only ONE payment so far (K2, K3 and K4 paid nothing)
GET {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}

> {%
    client.test("K5 one payment", () => {
        client.assert(response.body.payments.length === 1, "payments " + response.body.payments.length);
        client.assert(response.body.balance === 21, "balance " + response.body.balance);
    });
%}


### ---------------------------------------------------------- balance rules

### M1 25.00 with a new key ...0002, but only 21.00 is open  -> 409
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0002
Content-Type: application/json

{ "amount": 25.00, "method": "CARD" }

> {% client.test("M1 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### M2 the SAME key ...0002 with the right amount  -> 201 NEW (M1 failed, so its key was rolled back)
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0002
Content-Type: application/json

{ "amount": 21.00, "method": "CARD", "reference": "POS-7781" }

> {%
    client.test("M2 settles the invoice", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "false", "replayed header");
        client.assert(response.body.balanceAfter === 0, "balanceAfter " + response.body.balanceAfter);
        client.assert(response.body.invoicePaid === true, "invoicePaid");
        client.assert(response.body.reference === "POS-7781", "reference");
    });
%}

### M3 the invoice is PAID now, automatically
GET {{host}}/invoices/{{inv}}
Authorization: Bearer {{owner}}

> {%
    client.test("M3 PAID", () => {
        client.assert(response.body.status === "PAID", "status " + response.body.status);
        client.assert(response.body.paidAt !== null, "paidAt");
    });
%}

### M4 another payment for a PAID invoice  -> 409
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0003
Content-Type: application/json

{ "amount": 1.00, "method": "CASH" }

> {% client.test("M4 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### M5 K1 replayed AFTER the invoice was paid: the SAME answer as the first time (balance 21.00, not paid)
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day22-key-0001
Content-Type: application/json

{ "amount": 10.00, "method": "CASH" }

> {%
    client.test("M5 historic answer", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "true", "replayed header");
        client.assert(response.body.balanceAfter === 21, "balanceAfter " + response.body.balanceAfter);
        client.assert(response.body.invoicePaid === false, "invoicePaid");
    });
%}

### M6 the summary: 2 payments, 31.00 paid, 0.00 open
GET {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}

> {%
    client.test("M6 summary", () => {
        client.assert(response.body.status === "PAID", "status " + response.body.status);
        client.assert(response.body.payments.length === 2, "payments " + response.body.payments.length);
        client.assert(response.body.paid === 31, "paid " + response.body.paid);
        client.assert(response.body.balance === 0, "balance " + response.body.balance);
    });
%}

### M7 the temporary Day 20 endpoint is gone  -> 404
POST {{host}}/invoices/{{inv}}/mark-paid
Authorization: Bearer {{owner}}

> {% client.test("M7 404", () => client.assert(response.status === 404, "status " + response.status)); %}



### =====================================================================
### The audit log
### Before running: reload the seed (it empties audit_events, and A1 expects 0 events),
### start the app, then Run All.
###   cat scripts/dev-seed.sql | docker exec -i appointme-db psql -U appointme -d appointme
### =====================================================================

@host = http://localhost:8080

### L1 Alice logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "correct-horse-1" }

> {% client.global.set("aliceLogin", response.body.accessToken); %}

### L2 Alice picks tenant 1 (OWNER)
POST {{host}}/auth/select-tenant/1
Authorization: Bearer {{aliceLogin}}

> {% client.global.set("owner", response.body.accessToken); %}

### L3 Bob logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "correct-horse-1" }

> {% client.global.set("bobLogin", response.body.accessToken); %}

### L4 Bob picks tenant 1 (STAFF)
POST {{host}}/auth/select-tenant/1
Authorization: Bearer {{bobLogin}}

> {% client.global.set("staff", response.body.accessToken); %}

### L5 Gus logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "gus@test.com", "password": "correct-horse-1" }

> {% client.global.set("gusLogin", response.body.accessToken); %}

### L6 Gus picks tenant 2 (OWNER)
POST {{host}}/auth/select-tenant/2
Authorization: Bearer {{gusLogin}}

> {% client.global.set("gus", response.body.accessToken); %}

### ------------------------------------------------------ A: who may read

### A1 After a seed reload the log is empty (the seed writes tables directly, it is not a business action)
GET {{host}}/audit-events
Authorization: Bearer {{owner}}

> {% client.test("A1 200, empty", () => {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.totalElements === 0, "events: " + response.body.totalElements);
}); %}

### A2 No token
GET {{host}}/audit-events

> {% client.test("A2 401", () => client.assert(response.status === 401, "status " + response.status)); %}

### A3 Staff may not read the log
GET {{host}}/audit-events
Authorization: Bearer {{staff}}

> {% client.test("A3 403", () => client.assert(response.status === 403, "status " + response.status)); %}

### ------------------------------------------------------ B: the story of one invoice

### B1 Create a draft: Haircut 25.00 + 24 % tax = 31.00
POST {{host}}/invoices
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "customerId": 1, "lines": [ { "description": "Haircut", "quantity": 1, "unitPrice": 25.00 } ] }

> {% client.test("B1 201", () => client.assert(response.status === 201, "status " + response.status));
   client.global.set("inv", response.body.id); %}

### B2 Replace the lines
PUT {{host}}/invoices/{{inv}}/lines
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "lines": [ { "description": "Haircut and wash", "quantity": 1, "unitPrice": 25.00 } ] }

> {% client.test("B2 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### B3 Issue
POST {{host}}/invoices/{{inv}}/issue
Authorization: Bearer {{owner}}

> {% client.test("B3 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### B4 Pay 10.00. The reference is free text with a name in it: it must NOT reach the log (see C2)
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day23-pay-1
Content-Type: application/json

{ "amount": 10.00, "method": "CARD", "reference": "Card of Ann Secret" }

> {% client.test("B4 201", () => client.assert(response.status === 201, "status " + response.status)); %}

### B5 The same payment again (a retry): answered from the key, nothing happens
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day23-pay-1
Content-Type: application/json

{ "amount": 10.00, "method": "CARD", "reference": "Card of Ann Secret" }

> {% client.test("B5 replayed", () => {
    client.assert(response.status === 201, "status " + response.status);
    client.assert(response.headers.valueOf("Idempotent-Replayed") === "true", "not a replay");
}); %}

### B6 Too much: refused, so no event
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day23-pay-too-much
Content-Type: application/json

{ "amount": 999.00, "method": "CASH" }

> {% client.test("B6 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### B7 The rest: 21.00. The invoice becomes PAID
POST {{host}}/invoices/{{inv}}/payments
Authorization: Bearer {{owner}}
Idempotency-Key: day23-pay-2
Content-Type: application/json

{ "amount": 21.00, "method": "CASH" }

> {% client.test("B7 201", () => client.assert(response.status === 201, "status " + response.status)); %}

### C1 The whole story: 6 events, newest first. B5 and B6 added nothing
GET {{host}}/audit-events?entityType=INVOICE&entityId={{inv}}
Authorization: Bearer {{owner}}

> {% client.test("C1 the story", () => {
    client.assert(response.status === 200, "status " + response.status);
    const got = response.body.content.map(e => e.action).join(",");
    const want = "INVOICE_PAID,PAYMENT_RECORDED,PAYMENT_RECORDED,INVOICE_ISSUED,INVOICE_LINES_REPLACED,INVOICE_CREATED";
    client.assert(got === want, "got " + got);
    client.assert(response.body.content.every(e => e.actorUserId === 1), "actor must be Alice (user 1)");
}); %}

### C2 No personal data in the log
GET {{host}}/audit-events?action=PAYMENT_RECORDED&entityType=INVOICE&entityId={{inv}}
Authorization: Bearer {{owner}}

> {% client.test("C2 facts only", () => {
    client.assert(response.body.totalElements === 2, "events: " + response.body.totalElements);
    const text = JSON.stringify(response.body.content);
    client.assert(!text.includes("Secret"), "the reference leaked: " + text);
    client.assert(text.includes("CARD"), "the method should be there: " + text);
}); %}

### ------------------------------------------------------ D: the actor is whoever did it

### D1 Bob (staff) completes appointment 2, which is on Bob's own schedule. This also creates a draft invoice
PATCH {{host}}/appointments/2/status
Authorization: Bearer {{staff}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {% client.test("D1 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### D2 Bob (user 2) did two things: the status change and the automatic draft
GET {{host}}/audit-events?actorUserId=2
Authorization: Bearer {{owner}}

> {% client.test("D2 Bob's events", () => {
    const got = response.body.content.map(e => e.action).join(",");
    client.assert(got === "INVOICE_CREATED,APPOINTMENT_STATUS_CHANGED", "got " + got);
}); %}

### D3 The appointment's own story
GET {{host}}/audit-events?entityType=APPOINTMENT&entityId=2
Authorization: Bearer {{owner}}

> {% client.test("D3 from -> to", () => {
    client.assert(response.body.content[0].details === "SCHEDULED -> COMPLETED", response.body.content[0].details);
}); %}

### D4 A refused status change (COMPLETED is final): no new event
PATCH {{host}}/appointments/2/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "CANCELLED" }

> {% client.test("D4 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### D5 Still one event for appointment 2
GET {{host}}/audit-events?entityType=APPOINTMENT&entityId=2
Authorization: Bearer {{owner}}

> {% client.test("D5 one event", () => client.assert(response.body.totalElements === 1, "events: " + response.body.totalElements)); %}

### ------------------------------------------------------ E: history outlives the record

### E1 A new customer
POST {{host}}/customers
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "fullName": "Dora Private", "email": "dora.private@example.com" }

> {% client.test("E1 201", () => client.assert(response.status === 201, "status " + response.status));
   client.global.set("cust", response.body.id); %}

### E2 Delete the customer
DELETE {{host}}/customers/{{cust}}
Authorization: Bearer {{owner}}

> {% client.test("E2 2xx", () => client.assert(response.status >= 200 && response.status < 300, "status " + response.status)); %}

### E3 The customer is gone, the history is not, and it does not contain the customer's name
GET {{host}}/audit-events?entityType=CUSTOMER&entityId={{cust}}
Authorization: Bearer {{owner}}

> {% client.test("E3 history stays", () => {
    const got = response.body.content.map(e => e.action).join(",");
    client.assert(got === "CUSTOMER_DELETED,CUSTOMER_CREATED", "got " + got);
    const text = JSON.stringify(response.body.content);
    client.assert(!text.includes("Dora") && !text.includes("dora"), "personal data in the log: " + text);
}); %}

### E4 A billing change records before and after
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "taxRate": 0.1300, "currency": "EUR" }

> {% client.test("E4 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### E5 See it
GET {{host}}/audit-events?action=TENANT_BILLING_CHANGED
Authorization: Bearer {{owner}}

> {% client.test("E5 before and after", () => {
    const d = response.body.content[0].details;
    client.assert(d === "tax 0.2400 EUR -> tax 0.1300 EUR", "got " + d);
}); %}

### ------------------------------------------------------ F: another business

### F1 Gus (tenant 2) sees none of it
GET {{host}}/audit-events
Authorization: Bearer {{gus}}

> {% client.test("F1 empty", () => {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.totalElements === 0, "events: " + response.body.totalElements);
}); %}

### F2 Asking for tenant 1's invoice by id: an empty page, the same as "no such record"
GET {{host}}/audit-events?entityType=INVOICE&entityId={{inv}}
Authorization: Bearer {{gus}}

> {% client.test("F2 empty", () => {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.totalElements === 0, "events: " + response.body.totalElements);
}); %}

### ------------------------------------------------------ G: bad requests, paging, read-only

### G1 entityId without entityType
GET {{host}}/audit-events?entityId=1
Authorization: Bearer {{owner}}

> {% client.test("G1 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### G2 An unknown action
GET {{host}}/audit-events?action=NOPE
Authorization: Bearer {{owner}}

> {% client.test("G2 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### G3 from is not before to
GET {{host}}/audit-events?from=2026-02-01T00:00:00Z&to=2026-01-01T00:00:00Z
Authorization: Bearer {{owner}}

> {% client.test("G3 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### G4 size too big
GET {{host}}/audit-events?size=101
Authorization: Bearer {{owner}}

> {% client.test("G4 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### G5 A date range that holds everything
GET {{host}}/audit-events?from=2020-01-01T00:00:00Z&to=2100-01-01T00:00:00Z
Authorization: Bearer {{owner}}

> {% client.test("G5 finds events", () => client.assert(response.body.totalElements > 0, "events: " + response.body.totalElements)); %}

### G6 Paging: 2 per page, newest first
GET {{host}}/audit-events?size=2&page=0
Authorization: Bearer {{owner}}

> {% client.test("G6 2 rows", () => {
    client.assert(response.body.content.length === 2, "rows: " + response.body.content.length);
    client.assert(response.body.content[0].id > response.body.content[1].id, "newest first");
    client.assert(response.body.totalPages > 1, "pages: " + response.body.totalPages);
}); %}

### G7 The log cannot be written over HTTP
POST {{host}}/audit-events
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "action": "INVOICE_PAID", "entityType": "INVOICE", "entityId": 1 }

> {% client.test("G7 405", () => client.assert(response.status === 405, "status " + response.status)); %}

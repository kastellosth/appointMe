        client.assert(response.status === 200, "status " + response.status);
        client.assert(/^INV-\d{4}-0002$/.test(response.body.number), "number " + response.body.number);
    });
%}

### N3. Void the ISSUED invoice. EXPECT 200, VOID, and it KEEPS its number
POST {{baseUrl}}/invoices/{{invN1}}/void
Authorization: Bearer {{aliceToken}}

> {%
    client.test("N3: voided invoice keeps its number", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "VOID", "status");
        client.assert(/^INV-\d{4}-0002$/.test(response.body.number), "number " + response.body.number);
    });
%}


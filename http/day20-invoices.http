### 5. NUMBERING: sequential, per tenant, never reused
### ======================================================================

### N1. Draft: 1 x 40.00 at 24 % (tax 9.60, total 49.60). EXPECT 201
POST {{baseUrl}}/invoices
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "customerId": 2, "currency": "EUR", "lines": [ { "description": "Consultation", "quantity": 1, "unitPrice": 40.00, "taxRate": 0.24 } ] }

> {%
    client.global.set("invN1", response.body.id);
    client.test("N1: total 49.6", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.taxTotal === 9.6, "tax " + response.body.taxTotal);
        client.assert(response.body.total === 49.6, "total " + response.body.total);
    });
%}


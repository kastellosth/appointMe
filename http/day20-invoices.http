### ======================================================================
### 4. VOID, empty invoices and skipped steps
### ======================================================================

### V1. Create a draft (1 x 10.00, no tax). EXPECT 201
POST {{baseUrl}}/invoices
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "customerId": 1, "lines": [ { "description": "Mistake", "quantity": 1, "unitPrice": 10.00 } ] }

> {%
    client.global.set("invVoid", response.body.id);
    client.test("V1: draft created", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.total === 10, "total " + response.body.total);
        client.assert(response.body.taxTotal === 0, "no tax");
    });
%}

### V2. Void the DRAFT. EXPECT 200, VOID, number still null
POST {{baseUrl}}/invoices/{{invVoid}}/void
Authorization: Bearer {{aliceToken}}

> {%
    client.test("V2: draft voided", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "VOID", "status " + response.body.status);
        client.assert(response.body.number === null, "a voided draft never had a number");
    });
%}

### V3. Issue the VOID invoice. EXPECT 409 "VOID to ISSUED"
POST {{baseUrl}}/invoices/{{invVoid}}/issue
Authorization: Bearer {{aliceToken}}

> {%
    client.test("V3: void cannot be issued", function () {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(JSON.stringify(response.body).indexOf("VOID to ISSUED") >= 0, "message");
    });
%}

### V4. Void it again. EXPECT 409 "VOID to VOID"
POST {{baseUrl}}/invoices/{{invVoid}}/void
Authorization: Bearer {{aliceToken}}

> {%
    client.test("V4: void is final", function () {
        client.assert(response.status === 409, "status " + response.status);
    });
%}

### E1. A draft WITHOUT lines (the "lines" key is simply missing). EXPECT 201, total 0
POST {{baseUrl}}/invoices
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "customerId": 1 }

> {%
    client.global.set("invEmpty", response.body.id);
    client.test("E1: empty draft allowed", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.total === 0, "total " + response.body.total);
        client.assert(response.body.lines.length === 0, "no lines");
    });
%}

### E2. Issue the empty draft. EXPECT 409 "An invoice without lines cannot be issued"
POST {{baseUrl}}/invoices/{{invEmpty}}/issue
Authorization: Bearer {{aliceToken}}

> {%
    client.test("E2: empty invoice cannot be issued", function () {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(JSON.stringify(response.body).indexOf("without lines") >= 0, "message");
    });
%}

### E3. Mark the DRAFT as paid (skipping ISSUED). EXPECT 409 "DRAFT to PAID"
POST {{baseUrl}}/invoices/{{invEmpty}}/mark-paid
Authorization: Bearer {{aliceToken}}

> {%
    client.test("E3: cannot skip ISSUED", function () {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(JSON.stringify(response.body).indexOf("DRAFT to PAID") >= 0, "message");

### =====================================================================
### appointMe - day20-invoices.http   (Day 20: invoices and the status machine)
### SELF-CONTAINED: it logs in by itself and keeps its own ids.
###
### BEFORE YOU START (and before every re-run of this file)
###   1. V5__invoices.sql must be applied (start the app once).
###   2. Reload the seed (the Day 20 seed also empties the invoice tables and
###      restarts the invoice numbers):
###        Get-Content .\scripts\dev-seed.sql | docker exec -i appointme-db psql -U appointme -d appointme
###
### Money is shown by the API as plain JSON numbers: 60.00 appears as 60, 14.40 as 14.4.
### taxRate is a FRACTION: 0.24 means 24 %.
### Run the requests from top to bottom: later ones use ids saved by earlier ones.
### =====================================================================

@baseUrl = http://localhost:8080


### ======================================================================
### SETUP
### ======================================================================

### O1. Alice logs in. EXPECT 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "correct-horse-1" }

> {%
    client.global.set("aliceUserToken", response.body.accessToken);
%}

### O2. Alice selects tenant 1 (OWNER). EXPECT 200
POST {{baseUrl}}/auth/select-tenant/1
Authorization: Bearer {{aliceUserToken}}

> {%
    client.global.set("aliceToken", response.body.accessToken);
%}

### B1. Bob logs in. EXPECT 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "correct-horse-1" }

> {%
    client.global.set("bobUserToken", response.body.accessToken);
%}

### B2. Bob selects tenant 1 (STAFF). EXPECT 200
POST {{baseUrl}}/auth/select-tenant/1
Authorization: Bearer {{bobUserToken}}

> {%
    client.global.set("bobToken", response.body.accessToken);
%}

### G1. Gus logs in. EXPECT 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "gus@test.com", "password": "correct-horse-1" }

> {%
    client.global.set("gusUserToken", response.body.accessToken);
%}

### G2. Gus selects tenant 2 (OWNER of the OTHER business). EXPECT 200
POST {{baseUrl}}/auth/select-tenant/2
Authorization: Bearer {{gusUserToken}}

> {%
    client.global.set("gusToken", response.body.accessToken);
%}

### A0. An appointment for customer 2 (used later to test the appointment link). EXPECT 201
POST {{baseUrl}}/appointments
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "staffId": 2, "customerId": 2, "serviceId": 1, "startsAt": "2027-03-02T10:00:00Z", "notes": "for invoice tests" }

> {%
    client.global.set("apptId", response.body.id);
    client.test("A0: appointment created", function () {
        client.assert(response.status === 201, "status " + response.status);
    });
%}


### ======================================================================
### 1. A DRAFT invoice: create, read, edit
### ======================================================================

### D1. Draft for customer 1: 2 x 25.00 and 1 x 10.00, both with 24 % tax. EXPECT 201
###     subtotal 60, taxTotal 14.4 (12.00 + 2.40), total 74.4, status DRAFT, number null
POST {{baseUrl}}/invoices
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{
  "customerId": 1,
  "lines": [
    { "description": "Haircut",    "quantity": 2, "unitPrice": 25.00, "taxRate": 0.24 },
    { "description": "Beard trim", "quantity": 1, "unitPrice": 10.00, "taxRate": 0.24 }
  ]
}

> {%
    client.global.set("invMain", response.body.id);
    client.test("D1: draft created with exact totals", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.status === "DRAFT", "status " + response.body.status);
        client.assert(response.body.number === null, "a draft has no number yet");
        client.assert(response.body.currency === "EUR", "default currency");
        client.assert(response.body.subtotal === 60, "subtotal " + response.body.subtotal);
        client.assert(response.body.taxTotal === 14.4, "taxTotal " + response.body.taxTotal);
        client.assert(response.body.total === 74.4, "total " + response.body.total);
        client.assert(response.body.lines.length === 2, "lines " + response.body.lines.length);
        client.assert(response.body.lines[0].lineNo === 1 && response.body.lines[1].lineNo === 2, "line numbers");
    });
%}

### D2. Read it back. EXPECT 200, same data
GET {{baseUrl}}/invoices/{{invMain}}
Authorization: Bearer {{aliceToken}}

> {%
    client.test("D2: same data", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.total === 74.4, "total " + response.body.total);
        client.assert(response.body.lines[0].description === "Haircut", "first line");
    });
%}

### D3. Edit the DRAFT: replace all lines with 3 x 33.33 at 24 %. EXPECT 200
###     subtotal 99.99, taxTotal 24 (23.9976 rounded), total 123.99, ONE line
PUT {{baseUrl}}/invoices/{{invMain}}/lines
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "lines": [ { "description": "Treatment", "quantity": 3, "unitPrice": 33.33, "taxRate": 0.24 } ] }

> {%
    client.test("D3: lines replaced, totals recalculated", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.lines.length === 1, "lines " + response.body.lines.length);
        client.assert(response.body.subtotal === 99.99, "subtotal " + response.body.subtotal);
        client.assert(response.body.taxTotal === 24, "taxTotal " + response.body.taxTotal);
        client.assert(response.body.total === 123.99, "total " + response.body.total);
    });
%}


### ======================================================================
### 2. ISSUE: the invoice gets its number and is frozen
### ======================================================================

### I1. Issue it. EXPECT 200, ISSUED, number like INV-2026-0001, issuedAt and dueAt (14 days later)
POST {{baseUrl}}/invoices/{{invMain}}/issue
Authorization: Bearer {{aliceToken}}

> {%
    client.test("I1: issued with a number", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "ISSUED", "status " + response.body.status);
        client.assert(/^INV-\d{4}-0001$/.test(response.body.number), "number " + response.body.number);
        client.assert(response.body.issuedAt !== null && response.body.dueAt !== null, "dates");
        client.assert(response.body.paidAt === null, "not paid yet");
        client.assert(response.body.total === 123.99, "total unchanged");
    });
%}

### I2. Issue it AGAIN. EXPECT 409 "Invoice cannot go from ISSUED to ISSUED"
POST {{baseUrl}}/invoices/{{invMain}}/issue
Authorization: Bearer {{aliceToken}}

> {%
    client.test("I2: second issue refused", function () {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(JSON.stringify(response.body).indexOf("ISSUED to ISSUED") >= 0, "message");
    });
%}

### I3. Try to edit the lines of the ISSUED invoice. EXPECT 409 "Only a DRAFT invoice can be edited"
PUT {{baseUrl}}/invoices/{{invMain}}/lines
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "lines": [ { "description": "Sneaky discount", "quantity": 1, "unitPrice": 1.00, "taxRate": 0 } ] }

> {%
    client.test("I3: issued invoice cannot be edited", function () {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(JSON.stringify(response.body).indexOf("Only a DRAFT") >= 0, "message");
    });
%}

### I4. Nothing changed. EXPECT 200, still ISSUED, total 123.99, the ORIGINAL single line
GET {{baseUrl}}/invoices/{{invMain}}
Authorization: Bearer {{aliceToken}}

> {%
    client.test("I4: unchanged", function () {
        client.assert(response.body.status === "ISSUED", "status");
        client.assert(response.body.total === 123.99, "total " + response.body.total);
        client.assert(response.body.lines.length === 1 && response.body.lines[0].description === "Treatment", "lines");
    });
%}



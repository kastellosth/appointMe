### =====================================================================
### Automatic draft invoices, tenant billing settings, GET /invoices
### Before running: reload the seed (it creates appointments 1-4, see dev-seed.sql)
###   Get-Content .\scripts\dev-seed.sql | docker exec -i appointme-db psql -U appointme -d appointme
### Then: Run All. Every request has a client.test, so a red test is a real failure.
### =====================================================================

@host = http://localhost:8080

### L1 Alice logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "correct-horse-1" }

> {% client.global.set("aliceLogin", response.body.accessToken); %}

### L2 Alice picks tenant 1 (OWNER)
POST {{host}}/auth/select-tenant/1
Authorization: Bearer {{aliceLogin}}

> {% client.global.set("owner", response.body.accessToken); %}

### L3 Bob logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "correct-horse-1" }

> {% client.global.set("bobLogin", response.body.accessToken); %}

### L4 Bob picks tenant 1 (STAFF, membership 2)
POST {{host}}/auth/select-tenant/1
Authorization: Bearer {{bobLogin}}

> {% client.global.set("staff", response.body.accessToken); %}

### L5 Gus logs in
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "gus@test.com", "password": "correct-horse-1" }

> {% client.global.set("gusLogin", response.body.accessToken); %}

### L6 Gus picks tenant 2 (OWNER of the OTHER business)
POST {{host}}/auth/select-tenant/2
Authorization: Bearer {{gusLogin}}

> {% client.global.set("gus", response.body.accessToken); %}


### ---------------------------------------------------------- billing settings

### T1 tenant 1 has 24 % and EUR (from the seed)
GET {{host}}/tenants/current
Authorization: Bearer {{owner}}

> {%
    client.test("T1 200 with tax rate and currency", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.taxRate === 0.24, "taxRate " + response.body.taxRate);
        client.assert(response.body.currency === "EUR", "currency " + response.body.currency);
    });
%}

### T2 staff may NOT change billing  -> 403
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{staff}}
Content-Type: application/json

{ "taxRate": 0.10, "currency": "EUR" }

> {% client.test("T2 403", () => client.assert(response.status === 403, "status " + response.status)); %}

### T3 tax rate above 1  -> 400
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "taxRate": 1.5, "currency": "EUR" }

> {% client.test("T3 400", () => client.assert(response.status === 400, "status " + response.status)); %}

### T4 lowercase currency  -> 400
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "taxRate": 0.24, "currency": "eur" }

> {% client.test("T4 400", () => client.assert(response.status === 400, "status " + response.status)); %}


### ---------------------------------------------------------- completing creates a draft

### C1 appointment 4 is in the FUTURE: cannot be completed  -> 409
PATCH {{host}}/appointments/4/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {% client.test("C1 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### C2 ... and no invoice was created for it
GET {{host}}/invoices?appointmentId=4
Authorization: Bearer {{owner}}

> {%
    client.test("C2 no invoice for appointment 4", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.totalElements === 0, "totalElements " + response.body.totalElements);
    });
%}

### C3 appointment 1 (yesterday, Haircut 25.00, Ann) -> COMPLETED
PATCH {{host}}/appointments/1/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {%
    client.test("C3 200 COMPLETED", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "COMPLETED", "status " + response.body.status);
    });
%}

### C4 a DRAFT invoice exists for appointment 1: 25.00 + 6.00 tax = 31.00 EUR, no number yet
GET {{host}}/invoices?appointmentId=1
Authorization: Bearer {{owner}}

> {%
    client.test("C4 one draft, right amounts", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.totalElements === 1, "totalElements " + response.body.totalElements);
        const inv = response.body.content[0];
        client.assert(inv.status === "DRAFT", "status " + inv.status);
        client.assert(inv.customerId === 1, "customerId " + inv.customerId);
        client.assert(inv.subtotal === 25, "subtotal " + inv.subtotal);
        client.assert(inv.taxTotal === 6, "taxTotal " + inv.taxTotal);
        client.assert(inv.total === 31, "total " + inv.total);
        client.assert(inv.currency === "EUR", "currency " + inv.currency);
        client.assert(inv.number === null, "number " + inv.number);
        client.assert(inv.lines === undefined, "the list must not contain lines");
        client.global.set("autoInvoiceId", inv.id);
    });
%}

### C5 the full invoice: one line copied from the service, with the business's rate
GET {{host}}/invoices/{{autoInvoiceId}}
Authorization: Bearer {{owner}}

> {%
    client.test("C5 the line", () => {
        client.assert(response.status === 200, "status " + response.status);
        const line = response.body.lines[0];
        client.assert(response.body.lines.length === 1, "lines " + response.body.lines.length);
        client.assert(line.description.startsWith("Haircut ("), "description " + line.description);
        client.assert(line.quantity === 1, "quantity " + line.quantity);
        client.assert(line.unitPrice === 25, "unitPrice " + line.unitPrice);
        client.assert(line.taxRate === 0.24, "taxRate " + line.taxRate);
        client.assert(line.tax === 6, "tax " + line.tax);
    });
%}

### C6 completing it AGAIN  -> 409, and still only one invoice (checked in C9)
PATCH {{host}}/appointments/1/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {% client.test("C6 409", () => client.assert(response.status === 409, "status " + response.status)); %}

### C7 STAFF (Bob) completes HIS appointment 2 (Beard Trim 10.00)  -> 200
PATCH {{host}}/appointments/2/status
Authorization: Bearer {{staff}}
Content-Type: application/json

{ "status": "COMPLETED" }

> {% client.test("C7 200", () => client.assert(response.status === 200, "status " + response.status)); %}

### C8 ... the owner sees the draft: 10.00 + 2.40 = 12.40
GET {{host}}/invoices?appointmentId=2
Authorization: Bearer {{owner}}

> {%
    client.test("C8 draft for appointment 2", () => {
        client.assert(response.body.totalElements === 1, "totalElements " + response.body.totalElements);
        client.assert(response.body.content[0].total === 12.4, "total " + response.body.content[0].total);
    });
%}

### C9 still exactly one invoice for appointment 1 after C6
GET {{host}}/invoices?appointmentId=1
Authorization: Bearer {{owner}}

> {% client.test("C9 one", () => client.assert(response.body.totalElements === 1, "totalElements " + response.body.totalElements)); %}


### ---------------------------------------------------------- tenant isolation and roles

### S1 STAFF cannot list invoices  -> 403
GET {{host}}/invoices
Authorization: Bearer {{staff}}

> {% client.test("S1 403", () => client.assert(response.status === 403, "status " + response.status)); %}

### S2 Gus (tenant 2) filters by tenant 1's appointment: sees NOTHING (200, empty, not 403)
GET {{host}}/invoices?appointmentId=1
Authorization: Bearer {{gus}}

> {%
    client.test("S2 empty", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.totalElements === 0, "totalElements " + response.body.totalElements);
    });
%}

### S3 Gus opens tenant 1's invoice directly  -> 404
GET {{host}}/invoices/{{autoInvoiceId}}
Authorization: Bearer {{gus}}

> {% client.test("S3 404", () => client.assert(response.status === 404, "status " + response.status)); %}


### ---------------------------------------------------------- rounding and defaults

### R1 manual invoice, 3 lines of 0.10 WITHOUT taxRate  -> rate defaults to 24 %, tax is per line: 0.06 (not 0.07)
POST {{host}}/invoices
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "customerId": 2,
  "lines": [
    { "description": "Gel", "quantity": 1, "unitPrice": 0.10 },
    { "description": "Gel", "quantity": 1, "unitPrice": 0.10 },
    { "description": "Gel", "quantity": 1, "unitPrice": 0.10 }
  ]
}

> {%
    client.test("R1 per-line rounding", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.lines[0].taxRate === 0.24, "taxRate " + response.body.lines[0].taxRate);
        client.assert(response.body.taxTotal === 0.06, "taxTotal " + response.body.taxTotal);
        client.assert(response.body.total === 0.36, "total " + response.body.total);
        client.assert(response.body.currency === "EUR", "currency " + response.body.currency);
    });
%}


### ---------------------------------------------------------- a rate change does not touch old invoices

### X1 issue the automatic invoice  -> it gets number INV-<year>-0001
POST {{host}}/invoices/{{autoInvoiceId}}/issue
Authorization: Bearer {{owner}}

> {%
    client.test("X1 issued", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(/^INV-\d{4}-0001$/.test(response.body.number), "number " + response.body.number);
    });
%}

### X2 the owner changes the rate to 13 %
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "taxRate": 0.13, "currency": "EUR" }

> {%
    client.test("X2 200", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.taxRate === 0.13, "taxRate " + response.body.taxRate);
    });
%}

### X3 the issued invoice still says 6.00 tax (24 %)
GET {{host}}/invoices/{{autoInvoiceId}}
Authorization: Bearer {{owner}}

> {%
    client.test("X3 unchanged", () => {
        client.assert(response.body.taxTotal === 6, "taxTotal " + response.body.taxTotal);
        client.assert(response.body.lines[0].taxRate === 0.24, "taxRate " + response.body.lines[0].taxRate);
    });
%}

### X4 a NEW manual invoice uses 13 %: 100.00 -> 13.00
POST {{host}}/invoices
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "customerId": 1, "lines": [ { "description": "Gift card", "quantity": 1, "unitPrice": 100.00 } ] }

> {% client.test("X4 13 %", () => client.assert(response.body.taxTotal === 13, "taxTotal " + response.body.taxTotal)); %}

### X5 put the rate back to 24 % (so running the file twice gives the same results after a seed reload)
PUT {{host}}/tenants/current/billing
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "taxRate": 0.24, "currency": "EUR" }

> {% client.test("X5 200", () => client.assert(response.status === 200, "status " + response.status)); %}


### ---------------------------------------------------------- GET /invoices: paging and filters

### P1 page of 2: there are 4 invoices now (C3, C7, R1, X4)
GET {{host}}/invoices?size=2
Authorization: Bearer {{owner}}

> {%
    client.test("P1 paging", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.content.length === 2, "content " + response.body.content.length);
        client.assert(response.body.size === 2, "size " + response.body.size);
        client.assert(response.body.totalElements === 4, "totalElements " + response.body.totalElements);
        client.assert(response.body.totalPages === 2, "totalPages " + response.body.totalPages);
        // newest first
        const [a, b] = response.body.content;
        client.assert(new Date(a.createdAt) >= new Date(b.createdAt), "not newest first");
    });
%}

### P2 only ISSUED: exactly the one from X1
GET {{host}}/invoices?status=ISSUED
Authorization: Bearer {{owner}}

> {%
    client.test("P2 status filter", () => {
        client.assert(response.body.totalElements === 1, "totalElements " + response.body.totalElements);
        client.assert(response.body.content[0].status === "ISSUED", "status");
    });
%}

### P3 customer 2 (Ben): appointment 2 draft + R1  -> 2
GET {{host}}/invoices?customerId=2
Authorization: Bearer {{owner}}

> {% client.test("P3 customer filter", () => client.assert(response.body.totalElements === 2, "totalElements " + response.body.totalElements)); %}


### =====================================================================
### appointMe - day16-availability.http   (Day 16: free slots and time zones)
### SELF-CONTAINED: it logs in by itself and keeps its own tokens.
###
### BEFORE YOU START (and before every re-run of this file)
###   1. Reload the seed so the data is known:
###        Get-Content .\scripts\dev-seed.sql | docker exec -i appointme-db psql -U appointme -d appointme
###   2. Run SETUP top to bottom, then the rest in order.
###
### Cast (password for all: correct-horse-1)
###   ALICE = OWNER  of tenant 1 (membership 1)  seed hours: Mon-Fri 09:00-17:00
###   BOB   = STAFF  in tenant 1 (membership 2)  we REPLACE his hours in S1 (below)
###   GUS   = OWNER  of tenant 2 (membership 4, service 3)  <- foreign to Alice
### Tenant 1 time zone: Europe/Athens (UTC+2 in winter, UTC+3 in summer).
### Services: 1 = Haircut (30 min), 2 = Beard Trim (15 min)
###
### Bob's schedule used here (set by S1):
###   MONDAY    09:00-13:00 and 14:00-18:00   (lunch break)
###   TUESDAY   09:00-09:20                   (a deliberately tiny window)
###   SUNDAY    00:00-08:00                   (for the daylight-saving tests)
###
### Each request has built-in checks. IntelliJ shows PASSED / FAILED for them in the
### response panel, next to the "EXPECT" line written here.
### The slot times come back with the TENANT's offset, e.g. 2026-11-16T09:00:00+02:00.
### =====================================================================

@baseUrl = http://localhost:8080


### ======================================================================
### SETUP
### ======================================================================

### O1. Alice logs in. EXPECT 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "correct-horse-1" }

> {%
    client.global.set("aliceUserToken", response.body.accessToken);
%}

### O2. Alice selects tenant 1. EXPECT 200, OWNER
POST {{baseUrl}}/auth/select-tenant/1
Authorization: Bearer {{aliceUserToken}}

> {%
    client.global.set("aliceToken", response.body.accessToken);
%}

### W1. Bob logs in. EXPECT 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "correct-horse-1" }

> {%
    client.global.set("bobUserToken", response.body.accessToken);
%}

### W2. Bob selects tenant 1. EXPECT 200, STAFF
POST {{baseUrl}}/auth/select-tenant/1
Authorization: Bearer {{bobUserToken}}

> {%
    client.global.set("bobToken", response.body.accessToken);
%}

### S1. Alice sets Bob's test schedule (Day 15 endpoint). EXPECT 200, 4 intervals
PUT {{baseUrl}}/staff/2/working-hours
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{
  "intervals": [
    { "dayOfWeek": "MONDAY",  "start": "09:00", "end": "13:00" },
    { "dayOfWeek": "MONDAY",  "start": "14:00", "end": "18:00" },
    { "dayOfWeek": "TUESDAY", "start": "09:00", "end": "09:20" },
    { "dayOfWeek": "SUNDAY",  "start": "00:00", "end": "08:00" }
  ]
}

> {%
    client.test("S1: 4 intervals saved", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.intervals.length === 4, "intervals " + response.body.intervals.length);
    });
%}


### ======================================================================
### A. THE BASICS: Monday 2026-11-16, Bob, Haircut (30 min), default step (15)
### ======================================================================

### A1. No appointments yet. EXPECT 200, 30 slots:
###     09:00 ... 12:30 (15 slots), nothing from 13:00 to 14:00 (lunch), 14:00 ... 17:30 (15 slots)
###     Header fields: timezone Europe/Athens, durationMinutes 30, stepMinutes 15
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-16
Authorization: Bearer {{aliceToken}}

> {%
    client.test("A1: 30 slots, lunch gap, tenant zone", function () {
        client.assert(response.status === 200, "status " + response.status);
        var s = response.body.slots;
        client.assert(s.length === 30, "slot count " + s.length);
        client.assert(s[0].startsAt === "2026-11-16T09:00:00+02:00", "first " + s[0].startsAt);
        client.assert(s[14].startsAt === "2026-11-16T12:30:00+02:00", "last morning " + s[14].startsAt);
        client.assert(s[15].startsAt === "2026-11-16T14:00:00+02:00", "first afternoon " + s[15].startsAt);
        client.assert(s[29].startsAt === "2026-11-16T17:30:00+02:00", "last " + s[29].startsAt);
        client.assert(s[0].endsAt === "2026-11-16T09:30:00+02:00", "first slot end " + s[0].endsAt);
        client.assert(response.body.timezone === "Europe/Athens", "timezone " + response.body.timezone);
        client.assert(response.body.durationMinutes === 30, "duration");
        client.assert(response.body.stepMinutes === 15, "step");
    });
%}

### A2. The owner books Bob at 10:00 Athens time (= 08:00 UTC), 30 min. EXPECT 201
POST {{baseUrl}}/appointments
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "staffId": 2, "customerId": 1, "serviceId": 1,
  "startsAt": "2026-11-16T08:00:00Z", "notes": "day16 availability test" }

> {%
    client.global.set("apptId", response.body.id);
    client.test("A2: booked", function () {
        client.assert(response.status === 201, "status " + response.status);
    });
%}

### A3. Same query again. EXPECT 27 slots. 09:30 is KEPT (it ends exactly when the booking starts),
###     09:45, 10:00 and 10:15 are GONE (they overlap 10:00-10:30), 10:30 is KEPT (starts when it ends)
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-16
Authorization: Bearer {{aliceToken}}

> {%
    client.test("A3: three slots removed around the booking", function () {
        client.assert(response.status === 200, "status " + response.status);
        var starts = response.body.slots.map(function (x) { return x.startsAt; });
        client.assert(starts.length === 27, "slot count " + starts.length);
        client.assert(starts.indexOf("2026-11-16T09:30:00+02:00") >= 0, "09:30 should be kept");
        client.assert(starts.indexOf("2026-11-16T09:45:00+02:00") < 0, "09:45 should be gone");
        client.assert(starts.indexOf("2026-11-16T10:00:00+02:00") < 0, "10:00 should be gone");
        client.assert(starts.indexOf("2026-11-16T10:15:00+02:00") < 0, "10:15 should be gone");
        client.assert(starts.indexOf("2026-11-16T10:30:00+02:00") >= 0, "10:30 should be kept");
    });
%}

### A4. Cancel that appointment. EXPECT 200, CANCELLED
PATCH {{baseUrl}}/appointments/{{apptId}}/status
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{ "status": "CANCELLED" }

### A5. Cancelled bookings free their time. EXPECT 30 slots again
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-16
Authorization: Bearer {{aliceToken}}

> {%
    client.test("A5: back to 30 slots", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 30, "slot count " + response.body.slots.length);
    });
%}

### A6. A different staff member: Alice, Mon 09:00-17:00 (seed). EXPECT 31 slots (09:00 ... 16:30)
GET {{baseUrl}}/availability?staffId=1&serviceId=1&date=2026-11-16
Authorization: Bearer {{aliceToken}}

> {%
    client.test("A6: Alice has 31 slots", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 31, "slot count " + response.body.slots.length);
    });
%}


### ======================================================================
### B. EDGE CASES
### ======================================================================

### B1. Tuesday 2026-11-17: Bob works only 09:00-09:20. A 30-minute Haircut cannot fit.
###     EXPECT 200 and "slots": []   (an empty list, NOT an error)
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-17
Authorization: Bearer {{aliceToken}}

> {%
    client.test("B1: nothing fits", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 0, "slot count " + response.body.slots.length);
    });
%}

### B2. Same day, Beard Trim (15 min), step 15. EXPECT exactly 1 slot: 09:00
###     (09:15 + 15 min would end at 09:30, past the 09:20 end of the window)
GET {{baseUrl}}/availability?staffId=2&serviceId=2&date=2026-11-17
Authorization: Bearer {{aliceToken}}

> {%
    client.test("B2: one slot at 09:00", function () {
        client.assert(response.status === 200, "status " + response.status);
        var s = response.body.slots;
        client.assert(s.length === 1, "slot count " + s.length);
        client.assert(s[0].startsAt === "2026-11-17T09:00:00+02:00", "start " + s[0].startsAt);
    });
%}

### B3. Same, but a finer step. EXPECT 2 slots: 09:00 and 09:05
GET {{baseUrl}}/availability?staffId=2&serviceId=2&date=2026-11-17&stepMinutes=5
Authorization: Bearer {{aliceToken}}

> {%
    client.test("B3: 09:00 and 09:05", function () {
        client.assert(response.status === 200, "status " + response.status);
        var s = response.body.slots;
        client.assert(s.length === 2, "slot count " + s.length);
        client.assert(s[1].startsAt === "2026-11-17T09:05:00+02:00", "second " + s[1].startsAt);
        client.assert(response.body.stepMinutes === 5, "step");
    });
%}

### B4. Wednesday 2026-11-18: Bob has no hours. EXPECT 200, "slots": []
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-18
Authorization: Bearer {{aliceToken}}

> {%
    client.test("B4: day off", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 0, "slot count " + response.body.slots.length);
    });
%}

### B5. A date in the past (a Monday, so he "works"): slots that already started are dropped.
###     EXPECT 200, "slots": []
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2020-01-06
Authorization: Bearer {{aliceToken}}

> {%
    client.test("B5: past slots dropped", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 0, "slot count " + response.body.slots.length);
    });
%}


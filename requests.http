GET {{baseUrl}}/availability?staffId=abc&serviceId=1&date=2026-11-16
Authorization: Bearer {{aliceToken}}


### ======================================================================
### D. DAYLIGHT SAVING TIME   (Sunday 00:00-08:00, Haircut 30 min, step 60)
### A normal Sunday has 8 slots. Watch what the clock labels do on the two special days.
### (Europe/Athens switched back on Sunday 2026-10-25, the day before you got these
### requests, so we test next year's changes, which are in the future.)
### ======================================================================

### D1. A NORMAL Sunday, 2026-11-15. EXPECT 8 slots: 00:00 01:00 ... 07:00, all +02:00
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2026-11-15&stepMinutes=60
Authorization: Bearer {{aliceToken}}

> {%
    client.test("D1: normal Sunday, 8 slots", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.slots.length === 8, "slot count " + response.body.slots.length);
    });
%}

### D2. SPRING FORWARD, Sunday 2027-03-28: at 03:00 the clocks jump to 04:00, so the day has only
###     23 hours and the 00:00-08:00 window is 7 REAL hours.
###     EXPECT 7 slots: 00:00 01:00 02:00 (+02:00) then 04:00 05:00 06:00 07:00 (+03:00).
###     There is NO 03:00 slot: that wall-clock time does not exist that day.
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2027-03-28&stepMinutes=60
Authorization: Bearer {{aliceToken}}

> {%
    client.test("D2: spring forward, no 03:00", function () {
        client.assert(response.status === 200, "status " + response.status);
        var starts = response.body.slots.map(function (x) { return x.startsAt; });
        client.assert(starts.length === 7, "slot count " + starts.length);
        client.assert(starts[2] === "2027-03-28T02:00:00+02:00", "third " + starts[2]);
        client.assert(starts[3] === "2027-03-28T04:00:00+03:00", "fourth " + starts[3]);
        client.assert(starts[6] === "2027-03-28T07:00:00+03:00", "last " + starts[6]);
    });
%}

### D3. FALL BACK, Sunday 2027-10-31: at 04:00 the clocks return to 03:00, so the day has 25 hours
###     and the window is 9 REAL hours.
###     EXPECT 9 slots, and "03:00" appears TWICE with different offsets:
###     ... 02:00+03:00, 03:00+03:00, 03:00+02:00, 04:00+02:00 ...
###     The offset is what tells the two apart. This is why the API returns offsets.
GET {{baseUrl}}/availability?staffId=2&serviceId=1&date=2027-10-31&stepMinutes=60
Authorization: Bearer {{aliceToken}}

> {%
    client.test("D3: fall back, 03:00 twice", function () {
        client.assert(response.status === 200, "status " + response.status);
        var starts = response.body.slots.map(function (x) { return x.startsAt; });
        client.assert(starts.length === 9, "slot count " + starts.length);
        client.assert(starts[3] === "2027-10-31T03:00:00+03:00", "fourth " + starts[3]);
        client.assert(starts[4] === "2027-10-31T03:00:00+02:00", "fifth " + starts[4]);
        client.assert(starts[8] === "2027-10-31T07:00:00+02:00", "last " + starts[8]);
    });
%}


